# ==============================================================================
# VETRA PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values
# ==============================================================================

# Google Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Signing Secret (Generate using: openssl rand -base64 64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# PostgreSQL (Production Profile)
POSTGRES_DB=vetra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vetra
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Ports
SERVER_PORT=8080
FRONTEND_PORT=5173

# Frontend Vite
VITE_API_BASE_URL=/api/v1
