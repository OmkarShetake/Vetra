# resolve links - $0 may be a soft link
PRG="$0"

while [ -h "$PRG" ] ; do
  ls=$(ls -ld "$PRG")
  link=$(expr "$ls" : '.*-> \(.*\)$')
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=$(dirname "$PRG")"/$link"
  fi
done

PRGDIR=$(dirname "$PRG")
MAVEN_OPTS="${MAVEN_OPTS:-}"

# Download Maven wrapper jar if not present
WRAPPER_JAR="$PRGDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$PRGDIR/.mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$WRAPPER_JAR" ]; then
  DOWNLOAD_URL=$(grep 'wrapperUrl' "$WRAPPER_PROPERTIES" | cut -d= -f2-)
  echo "Downloading Maven Wrapper from $DOWNLOAD_URL"
  curl -o "$WRAPPER_JAR" "$DOWNLOAD_URL" -s || wget -O "$WRAPPER_JAR" "$DOWNLOAD_URL"
fi

exec java $MAVEN_OPTS -jar "$WRAPPER_JAR" "$@"
